<?php
namespace {{Namespace}}\Facades\V1{{ModulePath}};

use {{Namespace}}\Services\V1{{ModulePath}}\{{ServiceClass}};

class {{FacadeClass}}
{
    /**
     * 服务实例(单例)
     *
     * @var {{ServiceClass}}|null
     */
    private static ?{{ServiceClass}} $instance = null;

    /**
     * 获取服务实例
     *
     * @return {{ServiceClass}}
     */
    private static function getInstance(): {{ServiceClass}}
    {
        if (self::$instance === null) {
            self::$instance = new {{ServiceClass}}();
        }

        return self::$instance;
    }

    /**
     * 调用服务方法
     *
     * @param string $method 方法名
     * @param array $parameters 参数
     * @return mixed
     */
    public static function __callStatic(string $method, array $parameters)
    {
        $instance = static::getInstance();
        if (!method_exists($instance, $method)) {
            throw new \BadMethodCallException(
                sprintf('Call to undefined method %s::%s()', get_class($instance), $method)
            );
        }
        return $instance->$method(...$parameters);
    }
}
